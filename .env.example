# =============================================================
# GymFlow Backend — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# =============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────────
# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/gymflow
# Docker example:
# DATABASE_URL=postgresql://gymflow:gymflow@localhost:5432/gymflow
# Supabase/Neon/Railway: paste the full connection string from dashboard

# ── JWT Secrets (generate with: openssl rand -hex 64) ───────
JWT_ACCESS_SECRET=change_me_access_secret_min_64_chars_long_please_generate_with_openssl
JWT_REFRESH_SECRET=change_me_refresh_secret_min_64_chars_long_different_from_access

# ── JWT Expiry ───────────────────────────────────────────────
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ── Password Reset ───────────────────────────────────────────
# How long password reset tokens stay valid (in minutes)
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=60

# ── Brute Force Protection ───────────────────────────────────
# Number of failed login attempts before account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
# Lockout duration in minutes
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# ── Logging ──────────────────────────────────────────────────
# development | production
LOG_LEVEL=debug

# ── App Config ───────────────────────────────────────────────
APP_NAME=GymFlow
API_PREFIX=/api/v1
